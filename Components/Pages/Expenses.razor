@page "/expenses"
@using ExpenseTracker.Services
@using ExpenseTracker.Models
@inject ExpenseService ExpenseService

<PageTitle>Expenses</PageTitle>

<h1>My Expenses</h1>
@*LINQ Sum*@
<h3>Total spent: @expenses.Sum(e => e.Amount).ToString("C")</h3>


@*Adding expenses (Create)*@
<h3>Add Expense</h3>

<div>
	<label>Description</label>
	<input @bind="newExpense.Description" />
</div>

<div>
	<label>Amount</label>
	<input type="number" step="0.01" @bind="newExpense.Amount" />
</div>

<div>
	<label>Category</label>
	<input @bind="newExpense.Category"/>
</div>

<div>
	<label>Date</label>
	<input type="date" @bind="newExpense.Date" />
</div>

@*add button*@
<button @onclick="AddExpense">Add</button>
@if (!string.IsNullOrEmpty(errorMessage))
{
	<p style="color: red">@errorMessage</p>
}

@*editing expenses (update)*@
@*if expense exists, show edit expense ui*@
@if (editingExpense != null)
{
	<h3>Edit Expense</h3>

	<div>
		<label>Description</label>
		<input @bind="editingExpense.Description" />
	</div>

	<div>
		<label>Amount</label>
		<input type="number" step="0.01" @bind="editingExpense.Amount" />
	</div>

	<div>
		<label>Category</label>
		<input @bind="editingExpense.Category" />
	</div>

	<div>
		<label>Date</label>
		<input type="date" @bind="editingExpense.Date" />
	</div>

	<button @onclick="SaveChanges">Save Changes</button>
	<button @onclick="CancelEdit">Cancel</button>
}


<table class="table">

	<thead>
		<tr>
			<th>Description</th>
			<th>Amount</th>
			<th>Category</th>
			<th>Date</th>
			<th>Action</th>
		</tr>
	</thead>
	<tbody>
		@*display each exxpense in table*@
		@foreach (var expense in expenses)
		{
			<tr>
				<td>@expense.Description</td>
				<td>@expense.Amount.ToString("C")</td>
				<td>@expense.Category</td>
				<td>@expense.Date.ToShortDateString()</td>
				<td>
					<button @onclick="() => EditExpense(expense.Id)">Edit</button>
					<button @onclick="() => DeleteExpense(expense.Id)">Delete</button>
				</td>
			</tr>
		}
		
	</tbody>
</table>

@code {

	@inject IJSRuntime JS
	private string errorMessage = "";

	private int nextExpenseId = 3;
	//null when not editing
	private Expense? editingExpense;

	private List<Expense> expenses = new();

	protected override void OnInitialized()
	{
		expenses = ExpenseService.GetExpenses();
	}


	private Expense newExpense = new()
	{
		Date = DateTime.Today
	};

	private void AddExpense()
	{
		//if blank desc or no amount
		if(string.IsNullOrWhiteSpace(newExpense.Description) || newExpense.Amount <= 0)
		{
			errorMessage = "Description and amount can't be blank";
			return;
		}

		if (string.IsNullOrWhiteSpace(newExpense.Category))
		{
			newExpense.Category = "Uncategorized";
		}

		newExpense.Id = nextExpenseId;
		nextExpenseId++;
		//reset
		errorMessage = "";
		ExpenseService.AddExpense(newExpense);

		newExpense = new Expense
		{
			Date = DateTime.Today
		};
	}

	private void EditExpense(int id)
	{
		//LINQ
		//firstOrDefualt: searches collection and returns first element that satisfies conditon, null otherwise
		//e => e.Id == id: lamdba expr, for each expense, check if e.Id matches id
		var expense = expenses.FirstOrDefault(e => e.Id == id);

		if(expense != null)
		{
			//creates temp copy
			editingExpense = new Expense
				{
					Id = expense.Id,
					Description = expense.Description,
					Amount = expense.Amount,
					Category = expense.Category,
					Date = expense.Date

				};
		}
	}

	private void SaveChanges()
	{
		if(editingExpense == null)
		{
			return;
		}


		ExpenseService.UpdateExpense(editingExpense);

		//reset to null
		editingExpense = null;
	}

	private void CancelEdit()
	{
		//since the edit screen only shows when !=null, setting =null will remove it without saving changes
		editingExpense = null;
	}


	//task = async operation (waiting for javascript operation to finish b4 continuing)
	//dependddency injection
	private async Task DeleteExpense(int id)
	{	
		//inject IJSRuntime service to allow C# to call Javascript in browser
		//InvokeAsync calls JS function async and tells C# to expect bool as return
		//confirm is the JS function being calleddd
		bool confirmed = await JS.InvokeAsync<bool>(
			"confirm",
			"Are you sure you want to delete?"
		);

		if (confirmed)
		{
			//remove all from expenses with matching id (unique ids)
			ExpenseService.DeleteExpense(id);
		}

			
	}
}
